{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://psi.vazkii.net/",
    "sources": "https://github.com/VazkiiMods/Psi",
    "issues": "https://github.com/VazkiiMods/Psi/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "vazkii.psi.common.Psi"
    ],
    "client": [
      "vazkii.psi.client.PsiClient"
    ]
  },
  "mixins": [
    "psi.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "patchouli": ">=${patchouli_version}"
  },
  "suggests": {
    "jei": "*"
  }
}
